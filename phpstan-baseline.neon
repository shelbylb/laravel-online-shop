parameters:
	ignoreErrors:
		-
			message: '#^Call to an undefined method App\\Services\\ProductService\:\:getProductsByCategoryId\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: app/Http/Controllers/CategoryController.php

		-
			message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Model\:\:\$external_payment_id\.$#'
			identifier: property.notFound
			count: 1
			path: app/Http/Controllers/YooKassaController.php

		-
			message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Model\:\:\$id\.$#'
			identifier: property.notFound
			count: 1
			path: app/Http/Controllers/YooKassaController.php

		-
			message: '#^Parameter \#1 \$localPayment of method App\\Services\\YooKassaPaymentService\:\:synchronizePayment\(\) expects App\\Models\\OrderPayment, Illuminate\\Database\\Eloquent\\Model given\.$#'
			identifier: argument.type
			count: 1
			path: app/Http/Controllers/YooKassaController.php

		-
			message: '#^PHPDoc type array of property App\\Models\\Address\:\:\$casts is not covariant with PHPDoc type array\<string, string\> of overridden property Illuminate\\Database\\Eloquent\\Model\:\:\$casts\.$#'
			identifier: property.phpDocType
			count: 1
			path: app/Models/Address.php

		-
			message: '#^PHPDoc type array of property App\\Models\\Address\:\:\$fillable is not covariant with PHPDoc type list\<string\> of overridden property Illuminate\\Database\\Eloquent\\Model\:\:\$fillable\.$#'
			identifier: property.phpDocType
			count: 1
			path: app/Models/Address.php

		-
			message: '#^PHPDoc type array of property App\\Models\\Address\:\:\$hidden is not covariant with PHPDoc type list\<string\> of overridden property Illuminate\\Database\\Eloquent\\Model\:\:\$hidden\.$#'
			identifier: property.phpDocType
			count: 1
			path: app/Models/Address.php

		-
			message: '#^Offset ''accepted''\|''canceled''\|''completed''\|''paid''\|''pending''\|''shipped'' on array\{pending\: ''Ожидает оплаты'', accepted\: ''Заказ принят'', paid\: ''Оплачен'', shipped\: ''Отправлен'', completed\: ''Завершен'', canceled\: ''Отменен''\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: app/Models/Order.php

		-
			message: '#^Class App\\Listeners\\SendWelcomeEmail not found\.$#'
			identifier: class.notFound
			count: 1
			path: app/Providers/EventServiceProvider.php

		-
			message: '#^Property App\\DTOs\\CheckoutData\:\:\$set_as_default \(bool\) on left side of \?\? is not nullable\.$#'
			identifier: nullCoalesce.property
			count: 1
			path: app/Services/CheckoutService.php

		-
			message: '#^Right side of && is always true\.$#'
			identifier: booleanAnd.rightAlwaysTrue
			count: 1
			path: app/Services/CheckoutService.php

		-
			message: '#^Variable \$validatedData on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.variable
			count: 1
			path: app/Services/CheckoutService.php

